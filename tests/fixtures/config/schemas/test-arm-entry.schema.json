{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "test-arm-entry.schema.json",
 "description": "Made-up minimal schema for tests. It is not the dVRK project's schema.",
 "type": "object",
 "required": [
  "name",
  "type"
 ],
 "additionalProperties": false,
 "properties": {
  "name": {
   "type": "string"
  },
  "type": {
   "type": "string"
  },
  "arm_file": {
   "type": "string"
  },
  "period": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "base_frame": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "reference_frame": {
     "type": "string"
    },
    "transform": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
       "type": "number"
      }
     }
    }
   }
  }
 }
}